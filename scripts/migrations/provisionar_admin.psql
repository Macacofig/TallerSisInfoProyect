\set ON_ERROR_STOP on

\if :{?admin_email}
\else
\echo ERROR: Falta la variable admin_email.
\quit 1
\endif

SELECT set_config('hu17.admin_email', :'admin_email', false);

BEGIN;

DO $$
BEGIN
    IF (
        SELECT COUNT(*)
        FROM estudiantes
        WHERE lower(correo_electronico) = lower(current_setting('hu17.admin_email'))
    ) <> 1 THEN
        RAISE EXCEPTION 'Debe existir exactamente una cuenta para el correo indicado';
    END IF;
END
$$;

UPDATE estudiantes
SET rol = 'ADMIN'
WHERE lower(correo_electronico) = lower(current_setting('hu17.admin_email'))
  AND rol <> 'ADMIN'
RETURNING id, correo_electronico, rol;

COMMIT;

SELECT id, correo_electronico, rol
FROM estudiantes
WHERE lower(correo_electronico) = lower(current_setting('hu17.admin_email'));